  "tagline": "Find the grandmaster game closest to yours.",
  "meanings": {
    "faces": {
      "body": "The body text, a text serif with a weight axis from 100 to 900 and matching italics.",
      "code": "The code, the move lists, and the figures, with tabular numerals wherever digits line up.",
      "display": "The headings and the wordmark, an old-style serif with an optical-size axis from 12 to 24 at its one weight."
    },
    "palette": {
      "critical": "The critical state, always beside an icon and a label, and the Reference section's own color, which marks the section on its link card and carries no state there.",
      "dark": "The dark ground, and body text on the light ground.",
      "ground": "The light ground, and light text on the dark ground.",
      "light": "The board's light squares, and the lead on the dark ground.",
      "primary": "The lead color, the logo's piece, links on the light ground, and the board's dark squares.",
      "series_1": "The first series color.",
      "series_2": "The second series color.",
      "series_3": "The third series color, the clock's brass.",
      "series_4": "The fourth series color.",
      "series_5": "The fifth series color.",
      "series_6": "The sixth series color, the Viewer section's own, which no chart's series order takes.",
      "warning": "The warning state, always beside an icon and a label."
    },
    "roles": {
      "alert": "A message that something failed.",
      "data_black": "The fill of Black's share of a chart's bar.",
      "data_edge": "The outline a chart's bar holds a white share inside.",
      "glyph_dark": "The glyph a dark square draws under a page's text.",
      "glyph_light": "The glyph a light square draws under a page's text.",
      "ink": "The text of a page.",
      "page": "The ground of a page.",
      "quiet": "The text of a caption or a label.",
      "raised": "The ground of a card standing over a page.",
      "rule": "A line between two parts of a page.",
      "run": "A link, and the positions two games share.",
      "side": "The ground of the sidebar.",
      "stored": "The stored game.",
      "submitted": "The submitted game.",
      "tint": "The ground of a note or a picked row."
    }
  }
