#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Install the site's packages from `docs/bun.lock`, pruning any it no longer names, and link `node_modules` and `package.json` at the root to the site's own, so the suite under `tests/site/` and knip resolve them from the root"
#MISE dir         = "docs"

bun install --frozen-lockfile
bun prune
ln -sfn docs/node_modules ../node_modules
ln -sfn docs/package.json ../package.json
