#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Install the site's packages from `docs/bun.lock`, pruning any it no longer names, and link `tests/node_modules` to `docs/node_modules`, so the suite under `tests/site/` resolves them"
#MISE dir         = "docs"

bun install --frozen-lockfile
bun prune
ln -sfn ../docs/node_modules ../tests/node_modules
