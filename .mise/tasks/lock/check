#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "lockfile"
#MISE description = "Verify both lockfiles are in sync with their manifests"

uv lock --check
snapshot=$(mktemp)
cp -p .mise/mise.lock "$snapshot"
trap 'cmp -s "$snapshot" .mise/mise.lock || mv -f "$snapshot" .mise/mise.lock; rm -f "$snapshot"' EXIT
log=$(mise lock 2>&1) || { printf '%s\n' "$log" >&2; exit 1; }
printf '%s\n' "$log" >&2
if grep -q "failed to resolve" <<<"$log"; then
  exit 1
fi
diff -u "$snapshot" .mise/mise.lock >&2
