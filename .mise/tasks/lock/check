#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "lockfile"
#MISE description = "Verify every lockfile is in sync with its manifest"

source "$MISE_PROJECT_ROOT/.mise/lib/scripts.bash"

uv lock --check
each_script uv lock --check
cargo metadata --format-version 1 --locked --manifest-path rust/Cargo.toml >/dev/null
mise lock --check >&2
MISE_LOCKED_SCOPES=project mise install --dry-run --force --locked >&2
bun install --cwd docs --dry-run --frozen-lockfile --no-summary >&2
