#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Fail where an advisory database cannot be reached, on any advisory published for a package `uv.lock`, a task script's lockfile, `rust/Cargo.lock`, or `docs/bun.lock` resolves, or on a crate whose license, version, or source breaks a rule of `rust/.cargo/deny.toml`"

source "$MISE_PROJECT_ROOT/.mise/lib/scripts.bash"

uv audit --preview-features audit-command
each_script uv audit --preview-features audit-command
cargo-deny --locked --manifest-path rust/Cargo.toml check
bun audit --cwd docs
