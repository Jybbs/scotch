#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Fail where an advisory database cannot be reached, on any advisory published for a package `uv.lock`, a task script's lockfile, or `rust/Cargo.lock` resolves, on any `bun audit` reports for a package `docs/bun.lock` resolves, other than one whose `GHSA-` id `AUDIT_IGNORE` lists while no release fixes it, on any `mise audit` reports for a tool `.mise/config.toml` pins, other than one `AUDIT_IGNORE` lists for a contributor to check by hand while `mise audit` names no fixed release, or on a crate whose license, version, or source breaks a rule of `rust/.cargo/deny.toml`, and name each tool `mise audit` lists as unchecked"

source "$MISE_PROJECT_ROOT/.mise/lib/scripts.bash"

uv audit --preview-features audit-command
each_script uv audit --preview-features audit-command
cargo-deny --locked --manifest-path rust/Cargo.toml check

tools=$(
  { mise config ls --json && mise ls --json --no-global; } \
    | jq --arg config "$MISE_PROJECT_ROOT/.mise/config.toml" -enr '
      (input[] | select(.path == $config).tools) as $pinned
      | input
      | map_values(map(select(.source.path == $config).version) | select(. != []))
      | ($pinned - keys) as $unlisted
      | if $unlisted == [] then
          to_entries[] | "\(.key)@\(.value[])"
        else
          $unlisted
          | map("mise ls lists no version of \(.) from .mise/config.toml, so run mise relock where .mise/mise.lock lags its pin, remove the MISE_<TOOL>_VERSION variable or mise.local.toml entry naming another version, or run lock:audit on a platform its os list names\n")
          | add
          | halt_error(1)
        end
    '
)

reports=$(
  for tool in $tools; do
    report=$(mise audit --json "$tool") \
      || jq -e '.vulnerabilities[0]' <<< "$report" > /dev/null \
      || exit
    echo "$report"
  done
)

jq -r '
  .unchecked[]
  | "mise audit could not check \(.tool) \(.version), so lock:audit read no advisory for it"
' <<< "$reports" >&2

jq -n '
  [
    inputs.vulnerabilities[]
    | (.fixed | join(" or ")) as $fixed
    | ([.id, .aliases[] | select(IN($ARGS.positional[]))] | join(" and ")) as $listed
    | if $listed != "" then
        select($fixed != "")
        | "\(.id) is fixed in \(.tool) \($fixed), so delete \($listed) from AUDIT_IGNORE in .mise/config.toml and lift \(.tool) to a fixed release"
      elif $fixed != "" then
        "\(.id) affects \(.tool) \(.version) and is fixed in \(.tool) \($fixed), so lift \(.tool) in .mise/config.toml to a fixed release"
      else
        "\(.id) affects \(.tool) \(.version) and mise audit names no fixed release, so check it by hand, then lift \(.tool) to a fixed release or add it to AUDIT_IGNORE in .mise/config.toml"
      end
  ]
  | select(. != [])
  | join("\n") + "\n"
  | halt_error(1)
' --args ${AUDIT_IGNORE:-} <<< "$reports"

set --
for id in ${AUDIT_IGNORE:-}; do
  notice=$(jq --arg id "$id" -r '
    .vulnerabilities[]
    | select(any(.id, .aliases[]; . == $id))
    | "Setting \($id) aside while mise audit names no fixed release, so check it by hand: \(.summary)"
  ' <<< "$reports")
  if [[ -n "$notice" ]]; then
    echo "$notice" >&2
    continue
  fi
  if [[ "$id" != GHSA-* ]]; then
    echo "mise audit reports $id for no tool .mise/config.toml pins, so delete it from AUDIT_IGNORE" >&2
    continue
  fi
  advisory="$(gh api --jq '
    (
      [
        .vulnerabilities[]
        | select(.first_patched_version)
        | .package.name + " " + .first_patched_version
      ]
      | join(", ")
    ),
    .summary
  ' "/advisories/$id")"
  patched="${advisory%%$'\n'*}"
  if [[ -n "$patched" ]]; then
    echo "$id is fixed in $patched, so delete it from AUDIT_IGNORE in .mise/config.toml and lift the package to a patched release" >&2
    exit 1
  fi
  echo "Setting $id aside while no release fixes it: ${advisory#*$'\n'}" >&2
  set -- "$@" "--ignore=$id"
done
bun audit --cwd docs "$@"
