#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Fail where an advisory database cannot be reached, on any advisory published for a package `uv.lock`, a task script's lockfile, `rust/Cargo.lock`, or `docs/bun.lock` resolves, other than one `AUDIT_IGNORE` lists while no release fixes it, on any `mise audit` reports for a tool `.mise/config.toml` pins, other than one `AUDIT_IGNORE` lists and a contributor checks by hand while `mise audit` names no fixed release, or on a crate whose license, version, or source breaks a rule of `rust/.cargo/deny.toml`, naming each tool `mise audit` could not check"

source "$MISE_PROJECT_ROOT/.mise/lib/scripts.bash"

uv audit --preview-features audit-command
each_script uv audit --preview-features audit-command
cargo-deny --locked --manifest-path rust/Cargo.toml check

tools=$(
  mise ls --current --json --no-global \
    | jq --arg config "$MISE_PROJECT_ROOT/.mise/config.toml" -r '
      [
        to_entries[]
        | .key as $tool
        | .value[]
        | select(.source.path == $config)
        | "\($tool)@\(.version)"
      ]
      | if . == [] then
          "No tool mise lists comes from \($config), so lock:audit checked none\n"
          | halt_error
        end
      | .[]
    '
)

report=$(
  for tool in $tools; do
    audit=$(mise audit --json "$tool") \
      || jq -e '.vulnerabilities != []' <<< "$audit" > /dev/null \
      || exit
    echo "$audit"
  done | jq -s '{
    unchecked: map(.unchecked[]),
    vulnerabilities: map(.vulnerabilities[])
  }'
)

jq -r '
  .unchecked[]
  | "mise audit could not check \(.tool) \(.version), so lock:audit read no advisory for it"
' <<< "$report" >&2

failures=$(jq --arg ignore "${AUDIT_IGNORE:-}" -r '
  [$ignore | scan("\\S+")] as $listed
  | .vulnerabilities[]
  | (.fixed | join(" or ")) as $fixed
  | if any(.id, .aliases[]; IN($listed[])) then
      select($fixed != "")
      | "\(.id) is fixed in \(.tool) \($fixed), so delete it from AUDIT_IGNORE in .mise/config.toml and lift \(.tool) to a fixed release"
    elif $fixed != "" then
      "\(.id) affects \(.tool) \(.version) and is fixed in \(.tool) \($fixed), so lift \(.tool) in .mise/config.toml to a fixed release"
    else
      "\(.id) affects \(.tool) \(.version) and mise audit names no fixed release, so check it by hand, then lift \(.tool) to a fixed release or add it to AUDIT_IGNORE in .mise/config.toml"
    end
' <<< "$report")
if [[ -n "$failures" ]]; then
  echo "$failures" >&2
  exit 1
fi

set --
for id in ${AUDIT_IGNORE:-}; do
  summary=$(jq --arg id "$id" -r '
    first(.vulnerabilities[] | select(any(.id, .aliases[]; . == $id)) | .summary)
  ' <<< "$report")
  if [[ -n "$summary" ]]; then
    echo "Setting $id aside while mise audit names no fixed release, so check it by hand: $summary" >&2
    continue
  fi
  if [[ "$id" != GHSA-* ]]; then
    echo "mise audit reports $id for no tool .mise/config.toml pins, so delete it from AUDIT_IGNORE" >&2
    continue
  fi
  advisory="$(gh api --jq '
    (
      [
        .vulnerabilities[]
        | select(.first_patched_version)
        | .package.name + " " + .first_patched_version
      ]
      | join(", ")
    ),
    .summary
  ' "/advisories/$id")"
  patched="${advisory%%$'\n'*}"
  if [[ -n "$patched" ]]; then
    echo "$id is fixed in $patched, so delete it from AUDIT_IGNORE in .mise/config.toml and lift the package to a patched release" >&2
    exit 1
  fi
  echo "Setting $id aside while no release fixes it: ${advisory#*$'\n'}" >&2
  set -- "$@" "--ignore=$id"
done
bun audit --cwd docs "$@"
