{% extends "base.md.j2" %}
{% block details %}
{%- with cut = run.needs.draft.outputs %}
{%- if cut.state == "created" %}
The cut created the [draft release]({{ cut.url }}) for `{{ cut.version }}`.
{% elif cut.state == "refreshed" %}
The cut refreshed the notes of the [draft release]({{ cut.url }}) for `{{ cut.version }}`.
{% elif cut.state == "published" %}
The [published release]({{ cut.url }}) already carries `{{ cut.version }}`, so `mise bump` moves `[project].version` to the next version.
{% endif %}
{%- endwith %}
{%- endblock %}
